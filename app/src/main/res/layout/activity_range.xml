<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:padding="16dp">

    <TextView android:id="@+id/tvRangeStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary" android:textSize="14sp"
        android:gravity="end" android:text="" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary" android:textSize="14sp"
        android:letterSpacing="0.1" android:text="CORRECTION" android:gravity="center"
        android:layout_marginTop="8dp" />
    <TextView android:id="@+id/tvRangeCorrection"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:textColor="?attr/colorAccent" android:textSize="72sp" android:textStyle="bold"
        android:gravity="center" android:text="—" android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="28sp" android:autoSizeMaxTextSize="96sp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary" android:textSize="14sp"
        android:letterSpacing="0.1" android:text="SCORE" android:gravity="center" />
    <TextView android:id="@+id/tvRangeScore"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:textColor="?android:attr/textColorPrimary" android:textSize="72sp" android:textStyle="bold"
        android:gravity="center" android:text="0" android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="28sp" android:autoSizeMaxTextSize="96sp" />

    <TextView android:id="@+id/tvRangeWind"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary" android:textSize="18sp"
        android:gravity="center" android:text="" android:layout_marginBottom="8dp" />

    <Button android:id="@+id/btnRangeClose"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Close" android:textSize="18sp"
        style="@style/Sts.ActionButton" />
</LinearLayout>
