<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:padding="12dp">

    <TextView android:id="@+id/tvRangeStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary" android:textSize="14sp"
        android:gravity="end" android:text="" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary" android:textSize="15sp"
        android:letterSpacing="0.1" android:text="WIND — dial before the shot" android:gravity="center" />
    <TextView android:id="@+id/tvRangeWind"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.5"
        android:textColor="?attr/colorAccent" android:textSize="96sp" android:textStyle="bold"
        android:gravity="center" android:text="—" android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="32sp" android:autoSizeMaxTextSize="130sp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary" android:textSize="14sp"
        android:letterSpacing="0.1" android:text="GROUP — dial to centre" android:gravity="center" />
    <TextView android:id="@+id/tvRangeCorrection"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:textColor="?android:attr/textColorPrimary" android:textSize="56sp" android:textStyle="bold"
        android:gravity="center" android:text="—" android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="24sp" android:autoSizeMaxTextSize="80sp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary" android:textSize="14sp"
        android:letterSpacing="0.1" android:text="SCORE" android:gravity="center" />
    <TextView android:id="@+id/tvRangeScore"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:textColor="?android:attr/textColorPrimary" android:textSize="56sp" android:textStyle="bold"
        android:gravity="center" android:text="0" android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="24sp" android:autoSizeMaxTextSize="80sp" />

    <Button android:id="@+id/btnRangeClose"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Close" android:textSize="18sp"
        style="@style/Sts.ActionButton" />
</LinearLayout>
