<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground" android:padding="12dp">

    <TextView android:id="@+id/tvRangeStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary" android:textSize="14sp"
        android:gravity="end" android:text="" />

    <TextView android:id="@+id/tvRangeWindCaption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary" android:textSize="14sp"
        android:letterSpacing="0.08" android:gravity="center" android:text="WINDAGE" />
    <TextView android:id="@+id/tvRangeWind"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2"
        android:textColor="?attr/colorAccent" android:textSize="72sp" android:textStyle="bold"
        android:gravity="center" android:text="—" android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="26sp" android:autoSizeMaxTextSize="96sp" />

    <TextView android:id="@+id/tvRangeElevCaption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary" android:textSize="14sp"
        android:letterSpacing="0.08" android:gravity="center" android:text="ELEVATION" />
    <TextView android:id="@+id/tvRangeElev"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2"
        android:textColor="?attr/colorAccent" android:textSize="72sp" android:textStyle="bold"
        android:gravity="center" android:text="—" android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="26sp" android:autoSizeMaxTextSize="96sp" />

    <TextView android:id="@+id/tvRangeCorrCaption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary" android:textSize="14sp"
        android:letterSpacing="0.08" android:gravity="center" android:text="GROUP — dial to centre" />
    <TextView android:id="@+id/tvRangeCorrection"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:textColor="?android:attr/textColorPrimary" android:textSize="44sp" android:textStyle="bold"
        android:gravity="center" android:text="—" android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="20sp" android:autoSizeMaxTextSize="60sp" />
    <TextView android:id="@+id/tvRangeCorrAngle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary" android:textSize="14sp"
        android:gravity="center" android:text="" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary" android:textSize="14sp"
        android:letterSpacing="0.08" android:gravity="center" android:text="SCORE" />
    <TextView android:id="@+id/tvRangeScore"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:textColor="?android:attr/textColorPrimary" android:textSize="52sp" android:textStyle="bold"
        android:gravity="center" android:text="0" android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="22sp" android:autoSizeMaxTextSize="72sp" />

    <Button android:id="@+id/btnRangeClose"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Close" android:textSize="18sp" style="@style/Sts.ActionButton" />
</LinearLayout>
