# Line endings, settled once so a Windows checkout cannot change what the
# build sees. Without this, core.autocrlf decides per-machine and the working
# tree differs between clones — harmless for Kotlin and XML, NOT harmless for
# shell scripts: a .sh checked out with CRLF fails on Linux with
# "bad interpreter: No such file or directory".

# Normalise everything to LF inside the repository; Git may still present
# CRLF in the working tree on Windows for ordinary text files.
* text=auto

# Source and resources: LF in the repo, and LF on checkout too, so the tree
# matches CI exactly.
*.kt   text eol=lf
*.kts  text eol=lf
*.java text eol=lf
*.xml  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.pro  text eol=lf
*.properties text eol=lf

# MUST stay LF — these are executed by a Linux shell / interpreter.
*.sh    text eol=lf
*.py    text eol=lf
gradlew text eol=lf

# Never touched.
*.png binary
*.jpg binary
*.gz  binary
*.zip binary
*.keystore binary
